rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global safety net: deny everything by default
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // GLOBAL PRIMITIVES & RBAC HELPERS
    // =========================================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidCrewId(crewId) {
      return crewId is string && crewId.size() <= 32 && crewId.matches('^AG-LEO-[0-9]{2}$');
    }

    function isValidEmailKey(emailKey) {
      return emailKey is string && emailKey.size() >= 3 && emailKey.size() <= 254;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerifiedUser() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function authEmailLower() {
      return request.auth.token.email is string ? request.auth.token.email.lower() : '';
    }

    function isBootstrappedMedicalChief() {
      return isVerifiedUser() && authEmailLower() == 'manikantadindawar21@gmail.com';
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isMedicalChief() {
      return isBootstrappedMedicalChief() || (
        isVerifiedUser() &&
        userDocExists() &&
        userDoc().role == 'MEDICAL_CHIEF' &&
        userDoc().accountStatus == 'ACTIVE'
      );
    }

    function isActiveAstronaut() {
      return isVerifiedUser() &&
        userDocExists() &&
        userDoc().role == 'ASTRONAUT' &&
        userDoc().accountStatus == 'ACTIVE' &&
        isValidCrewId(userDoc().crewId);
    }

    function isActiveUser() {
      return isMedicalChief() || isActiveAstronaut();
    }

    function isCrewOwner(crewId) {
      return isActiveAstronaut() && userDoc().crewId == crewId;
    }

    function hasProvisionedMatch(data) {
      return isVerifiedUser() &&
        authEmailLower() != '' &&
        exists(/databases/$(database)/documents/provisionedAccounts/$(authEmailLower())) &&
        get(/databases/$(database)/documents/provisionedAccounts/$(authEmailLower())).data.role == data.role &&
        get(/databases/$(database)/documents/provisionedAccounts/$(authEmailLower())).data.crewId == data.crewId;
    }

    // =========================================================================
    // ENTITY VALIDATION HELPERS
    // =========================================================================
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
        'userId', 'email', 'displayName', 'role', 'crewId', 'accountStatus', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'userId', 'email', 'displayName', 'role', 'crewId', 'accountStatus', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.userId) &&
      data.userId == userId &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
      data.role in ['ASTRONAUT', 'MEDICAL_CHIEF'] &&
      data.crewId is string && data.crewId.size() <= 32 &&
      data.crewId.matches('^(AG-LEO-[0-9]{2}|MCC-ALL|UNASSIGNED)$') &&
      data.accountStatus in ['ACTIVE', 'PENDING', 'SUSPENDED'] &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidProvisionedAccount(data, emailKey) {
      return data.keys().hasAll([
        'emailKey', 'email', 'displayName', 'role', 'crewId', 'missionRole', 'provisionedBy', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'emailKey', 'email', 'displayName', 'role', 'crewId', 'missionRole', 'provisionedBy', 'createdAt', 'updatedAt'
      ]) &&
      isValidEmailKey(data.emailKey) &&
      data.emailKey == emailKey &&
      data.email is string && data.email.size() >= 3 && data.email.size() <= 254 &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120 &&
      data.role in ['ASTRONAUT', 'MEDICAL_CHIEF'] &&
      data.crewId is string && data.crewId.size() <= 32 &&
      data.crewId.matches('^(AG-LEO-[0-9]{2}|MCC-ALL)$') &&
      data.missionRole is string && data.missionRole.size() >= 1 && data.missionRole.size() <= 120 &&
      isValidId(data.provisionedBy) &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCrewMember(data, crewId) {
      return data.keys().hasAll([
        'crewId', 'name', 'missionRole', 'missionId', 'missionDay',
        'orbitAltitude', 'inclination', 'bp', 'readiness', 'isSimulated', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'crewId', 'name', 'missionRole', 'missionId', 'missionDay',
        'orbitAltitude', 'inclination', 'bp', 'readiness', 'isSimulated', 'updatedAt'
      ]) &&
      isValidCrewId(data.crewId) &&
      data.crewId == crewId &&
      data.name is string && data.name.size() >= 1 && data.name.size() <= 120 &&
      data.missionRole is string && data.missionRole.size() >= 1 && data.missionRole.size() <= 120 &&
      data.missionId is string && data.missionId.size() >= 1 && data.missionId.size() <= 64 &&
      data.missionDay is string && data.missionDay.size() >= 1 && data.missionDay.size() <= 64 &&
      data.orbitAltitude is string && data.orbitAltitude.size() >= 1 && data.orbitAltitude.size() <= 64 &&
      data.inclination is string && data.inclination.size() >= 1 && data.inclination.size() <= 32 &&
      data.bp is string && data.bp.size() >= 1 && data.bp.size() <= 32 &&
      data.readiness is number && data.readiness >= 0 && data.readiness <= 100 &&
      data.isSimulated is bool &&
      data.updatedAt is timestamp;
    }

    function isValidReadingsMap(r) {
      return r is map &&
        r.keys().hasAll([
          'heartRate', 'spo2', 'cabinOxygen', 'radiation',
          'coreTemp', 'hydration', 'nutrition', 'stress', 'sleep'
        ]) &&
        r.keys().hasOnly([
          'heartRate', 'spo2', 'cabinOxygen', 'radiation',
          'coreTemp', 'hydration', 'nutrition', 'stress', 'sleep'
        ]) &&
        (r.heartRate == null || r.heartRate is number) &&
        (r.spo2 == null || r.spo2 is number) &&
        (r.cabinOxygen == null || r.cabinOxygen is number) &&
        (r.radiation == null || r.radiation is number) &&
        (r.coreTemp == null || r.coreTemp is number) &&
        (r.hydration == null || r.hydration is number) &&
        (r.nutrition == null || r.nutrition is number) &&
        (r.stress == null || r.stress is number) &&
        (r.sleep == null || r.sleep is number);
    }

    function isValidHealthRecord(data, crewId) {
      return data.keys().hasAll([
        'crewId', 'evaluatedStatus', 'statusHeadline', 'statusSubtext',
        'primaryParameter', 'primaryReading', 'hasMissingCriticalData',
        'hrv', 'readings', 'scenarioId', 'isSimulated', 'updatedBy', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'crewId', 'evaluatedStatus', 'statusHeadline', 'statusSubtext',
        'primaryParameter', 'primaryReading', 'hasMissingCriticalData',
        'hrv', 'readings', 'scenarioId', 'isSimulated', 'updatedBy', 'updatedAt'
      ]) &&
      isValidCrewId(data.crewId) &&
      data.crewId == crewId &&
      data.evaluatedStatus in ['SAFE', 'CAUTION', 'DANGER'] &&
      data.statusHeadline is string && data.statusHeadline.size() >= 1 && data.statusHeadline.size() <= 160 &&
      data.statusSubtext is string && data.statusSubtext.size() >= 1 && data.statusSubtext.size() <= 300 &&
      data.primaryParameter is string && data.primaryParameter.size() <= 120 &&
      data.primaryReading is string && data.primaryReading.size() <= 80 &&
      data.hasMissingCriticalData is bool &&
      data.hrv is number && data.hrv >= 0 && data.hrv <= 300 &&
      isValidReadingsMap(data.readings) &&
      data.scenarioId in ['SAFE', 'CAUTION', 'DANGER', 'MISSING_SENSOR'] &&
      data.isSimulated is bool &&
      isValidId(data.updatedBy) &&
      data.updatedAt is timestamp;
    }

    function isValidHistoryEntry(data, crewId, recordId) {
      return data.keys().hasAll([
        'recordId', 'crewId', 'date', 'phase', 'metric', 'value', 'baselineDelta', 'status', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'recordId', 'crewId', 'date', 'phase', 'metric', 'value', 'baselineDelta', 'status', 'createdAt'
      ]) &&
      isValidId(data.recordId) &&
      data.recordId == recordId &&
      isValidCrewId(data.crewId) &&
      data.crewId == crewId &&
      data.date is string && data.date.size() >= 1 && data.date.size() <= 64 &&
      data.phase is string && data.phase.size() >= 1 && data.phase.size() <= 120 &&
      data.metric is string && data.metric.size() >= 1 && data.metric.size() <= 160 &&
      data.value is string && data.value.size() >= 1 && data.value.size() <= 120 &&
      data.baselineDelta is string && data.baselineDelta.size() >= 1 && data.baselineDelta.size() <= 120 &&
      data.status in ['Nominal', 'Monitored', 'Critical'] &&
      data.createdAt is timestamp;
    }

    function isValidAssessmentEntry(data, crewId, assessmentId) {
      return data.keys().hasAll([
        'assessmentId', 'crewId', 'authorUserId', 'sleepQuality', 'fatigueLevel',
        'vestibularComfort', 'hydrationAdequacy', 'visualClarity', 'readinessScore', 'notes', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'assessmentId', 'crewId', 'authorUserId', 'sleepQuality', 'fatigueLevel',
        'vestibularComfort', 'hydrationAdequacy', 'visualClarity', 'readinessScore', 'notes', 'createdAt'
      ]) &&
      isValidId(data.assessmentId) &&
      data.assessmentId == assessmentId &&
      isValidCrewId(data.crewId) &&
      data.crewId == crewId &&
      isValidId(data.authorUserId) &&
      data.authorUserId == request.auth.uid &&
      data.sleepQuality is number && data.sleepQuality >= 1 && data.sleepQuality <= 10 &&
      data.fatigueLevel is number && data.fatigueLevel >= 1 && data.fatigueLevel <= 10 &&
      data.vestibularComfort is number && data.vestibularComfort >= 1 && data.vestibularComfort <= 10 &&
      data.hydrationAdequacy is number && data.hydrationAdequacy >= 1 && data.hydrationAdequacy <= 10 &&
      data.visualClarity is number && data.visualClarity >= 1 && data.visualClarity <= 10 &&
      data.readinessScore is number && data.readinessScore >= 0 && data.readinessScore <= 100 &&
      data.notes is string && data.notes.size() <= 1000 &&
      data.createdAt is timestamp;
    }

    function isValidAlert(data, alertId) {
      return data.keys().hasAll([
        'alertId', 'crewId', 'astronautName', 'severity', 'affectedParameter',
        'parameterLabel', 'previousStatus', 'newStatus', 'currentReading',
        'previousReading', 'associatedCountermeasure', 'message',
        'acknowledgementStatus', 'acknowledgedBy', 'acknowledgedByUid', 'acknowledgedAt',
        'resolutionStatus', 'resolvedBy', 'resolvedAt', 'timestampLabel',
        'isSimulated', 'createdAt', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'alertId', 'crewId', 'astronautName', 'severity', 'affectedParameter',
        'parameterLabel', 'previousStatus', 'newStatus', 'currentReading',
        'previousReading', 'associatedCountermeasure', 'message',
        'acknowledgementStatus', 'acknowledgedBy', 'acknowledgedByUid', 'acknowledgedAt',
        'resolutionStatus', 'resolvedBy', 'resolvedAt', 'timestampLabel',
        'isSimulated', 'createdAt', 'updatedAt'
      ]) &&
      isValidId(data.alertId) &&
      data.alertId == alertId &&
      isValidCrewId(data.crewId) &&
      data.astronautName is string && data.astronautName.size() >= 1 && data.astronautName.size() <= 120 &&
      data.severity in ['CAUTION', 'CRITICAL'] &&
      data.affectedParameter is string && data.affectedParameter.size() >= 1 && data.affectedParameter.size() <= 64 &&
      data.parameterLabel is string && data.parameterLabel.size() >= 1 && data.parameterLabel.size() <= 120 &&
      data.previousStatus in ['SAFE', 'CAUTION', 'DANGER'] &&
      data.newStatus in ['SAFE', 'CAUTION', 'DANGER'] &&
      data.currentReading is string && data.currentReading.size() >= 1 && data.currentReading.size() <= 80 &&
      data.previousReading is string && data.previousReading.size() >= 1 && data.previousReading.size() <= 80 &&
      data.associatedCountermeasure is string && data.associatedCountermeasure.size() >= 1 && data.associatedCountermeasure.size() <= 300 &&
      data.message is string && data.message.size() >= 1 && data.message.size() <= 400 &&
      data.acknowledgementStatus in ['UNACKNOWLEDGED', 'ACKNOWLEDGED'] &&
      data.acknowledgedBy is string && data.acknowledgedBy.size() <= 160 &&
      data.acknowledgedByUid is string && data.acknowledgedByUid.size() <= 128 &&
      data.acknowledgedAt is string && data.acknowledgedAt.size() <= 64 &&
      data.resolutionStatus in ['OPEN', 'IN_REVIEW', 'RESOLVED'] &&
      data.resolvedBy is string && data.resolvedBy.size() <= 160 &&
      data.resolvedAt is string && data.resolvedAt.size() <= 64 &&
      data.timestampLabel is string && data.timestampLabel.size() >= 1 && data.timestampLabel.size() <= 64 &&
      data.isSimulated is bool &&
      data.createdAt is timestamp &&
      data.updatedAt is timestamp;
    }

    function isValidCountermeasureRecord(data, recordId) {
      return data.keys().hasAll([
        'recordId', 'crewId', 'countermeasureId', 'code', 'title', 'category',
        'schedule', 'target', 'intensity', 'duration', 'completionStatus',
        'progress', 'notes', 'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'recordId', 'crewId', 'countermeasureId', 'code', 'title', 'category',
        'schedule', 'target', 'intensity', 'duration', 'completionStatus',
        'progress', 'notes', 'updatedAt'
      ]) &&
      isValidId(data.recordId) &&
      data.recordId == recordId &&
      isValidCrewId(data.crewId) &&
      data.countermeasureId is string && data.countermeasureId.size() >= 1 && data.countermeasureId.size() <= 64 &&
      data.code is string && data.code.size() >= 1 && data.code.size() <= 32 &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
      data.category is string && data.category.size() >= 1 && data.category.size() <= 120 &&
      data.schedule is string && data.schedule.size() >= 1 && data.schedule.size() <= 120 &&
      data.target is string && data.target.size() >= 1 && data.target.size() <= 200 &&
      data.intensity is string && data.intensity.size() >= 1 && data.intensity.size() <= 120 &&
      data.duration is string && data.duration.size() >= 1 && data.duration.size() <= 64 &&
      data.completionStatus in ['PENDING', 'IN_PROGRESS', 'COMPLETED'] &&
      data.progress is number && data.progress >= 0 && data.progress <= 100 &&
      data.notes is string && data.notes.size() <= 400 &&
      data.updatedAt is timestamp;
    }

    function isValidSurgeonNote(data, noteId) {
      return data.keys().hasAll([
        'noteId', 'crewId', 'authorUserId', 'author', 'time', 'text', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'noteId', 'crewId', 'authorUserId', 'author', 'time', 'text', 'createdAt'
      ]) &&
      isValidId(data.noteId) &&
      data.noteId == noteId &&
      isValidCrewId(data.crewId) &&
      isValidId(data.authorUserId) &&
      data.authorUserId == request.auth.uid &&
      data.author is string && data.author.size() >= 1 && data.author.size() <= 160 &&
      data.time is string && data.time.size() >= 1 && data.time.size() <= 64 &&
      data.text is string && data.text.size() >= 1 && data.text.size() <= 1000 &&
      data.createdAt is timestamp;
    }

    function isValidEvaluationConfig(data, configId) {
      return data.keys().hasAll(['configId', 'rules', 'updatedBy', 'updatedAt']) &&
        data.keys().hasOnly(['configId', 'rules', 'updatedBy', 'updatedAt']) &&
        configId == 'default' &&
        data.configId == 'default' &&
        data.rules is map &&
        isValidId(data.updatedBy) &&
        data.updatedBy == request.auth.uid &&
        data.updatedAt is timestamp;
    }

    function isValidAuditLog(data, logId) {
      return data.keys().hasAll([
        'logId', 'actorUserId', 'actorEmail', 'actorRole', 'action', 'targetRecord', 'details', 'createdAt'
      ]) &&
      data.keys().hasOnly([
        'logId', 'actorUserId', 'actorEmail', 'actorRole', 'action', 'targetRecord', 'details', 'createdAt'
      ]) &&
      isValidId(data.logId) &&
      data.logId == logId &&
      isValidId(data.actorUserId) &&
      data.actorUserId == request.auth.uid &&
      data.actorEmail is string && data.actorEmail.size() >= 3 && data.actorEmail.size() <= 254 &&
      data.actorRole in ['ASTRONAUT', 'MEDICAL_CHIEF', 'UNASSIGNED'] &&
      data.action is string && data.action.size() >= 1 && data.action.size() <= 120 &&
      data.targetRecord is string && data.targetRecord.size() >= 1 && data.targetRecord.size() <= 200 &&
      data.details is string && data.details.size() <= 500 &&
      data.createdAt is timestamp;
    }

    // =========================================================================
    // COLLECTION RULES
    // =========================================================================

    // 1. Users RBAC profiles (NO self-elevation to MEDICAL_CHIEF; NO role mutation by user)
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isMedicalChief());
      allow list: if isMedicalChief();
      allow create: if isValidId(userId) &&
        isVerifiedUser() &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        (
          isMedicalChief() ||
          (
            request.auth.uid == userId &&
            incoming().email.lower() == authEmailLower() &&
            (
              (hasProvisionedMatch(incoming()) && incoming().accountStatus == 'ACTIVE') ||
              (incoming().role == 'ASTRONAUT' && incoming().crewId == 'UNASSIGNED' && incoming().accountStatus == 'PENDING')
            )
          )
        );
      allow update: if isValidId(userId) &&
        isVerifiedUser() &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        incoming().userId == existing().userId &&
        (
          isMedicalChief() ||
          (
            request.auth.uid == userId &&
            incoming().role == existing().role &&
            incoming().crewId == existing().crewId &&
            incoming().accountStatus == existing().accountStatus &&
            incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    // 2. Pre-provisioned role & crewId bindings (Medical Chief writes; user can read own email binding only)
    match /provisionedAccounts/{emailKey} {
      allow get: if isValidEmailKey(emailKey) && isVerifiedUser() &&
        (isMedicalChief() || authEmailLower() == emailKey.lower());
      allow list: if isMedicalChief();
      allow create: if isValidEmailKey(emailKey) &&
        isMedicalChief() &&
        isValidProvisionedAccount(incoming(), emailKey) &&
        incoming().provisionedBy == request.auth.uid &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;
      allow update: if isValidEmailKey(emailKey) &&
        isMedicalChief() &&
        isValidProvisionedAccount(incoming(), emailKey) &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time;
      allow delete: if isValidEmailKey(emailKey) && isMedicalChief();
    }

    // 3. Crew roster metadata (Astronaut reads ONLY own crewId; CANNOT list full crew)
    match /crew/{crewId} {
      allow get: if isValidCrewId(crewId) && (isMedicalChief() || isCrewOwner(crewId));
      allow list: if isMedicalChief();
      allow create: if isValidCrewId(crewId) &&
        isMedicalChief() &&
        isValidCrewMember(incoming(), crewId) &&
        incoming().updatedAt == request.time;
      allow update: if isValidCrewId(crewId) &&
        isMedicalChief() &&
        isValidCrewMember(incoming(), crewId) &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // 4. Health records + subcollections (Strict crewId isolation)
    match /healthRecords/{crewId} {
      allow get: if isValidCrewId(crewId) && (isMedicalChief() || isCrewOwner(crewId));
      allow list: if isMedicalChief();
      allow create: if isValidCrewId(crewId) &&
        isValidHealthRecord(incoming(), crewId) &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        (isMedicalChief() || isCrewOwner(crewId));
      allow update: if isValidCrewId(crewId) &&
        isValidHealthRecord(incoming(), crewId) &&
        incoming().crewId == existing().crewId &&
        incoming().updatedBy == request.auth.uid &&
        incoming().updatedAt == request.time &&
        (isMedicalChief() || isCrewOwner(crewId));
      allow delete: if false;

      match /history/{recordId} {
        allow get: if isValidCrewId(crewId) && isValidId(recordId) &&
          (isMedicalChief() || isCrewOwner(crewId));
        allow list: if isMedicalChief() || isCrewOwner(crewId);
        allow create: if isValidCrewId(crewId) && isValidId(recordId) &&
          isValidHistoryEntry(incoming(), crewId, recordId) &&
          incoming().createdAt == request.time &&
          (isMedicalChief() || isCrewOwner(crewId));
        allow update, delete: if false;
      }

      match /assessments/{assessmentId} {
        allow get: if isValidCrewId(crewId) && isValidId(assessmentId) &&
          (isMedicalChief() || isCrewOwner(crewId));
        allow list: if isMedicalChief() || isCrewOwner(crewId);
        allow create: if isValidCrewId(crewId) && isValidId(assessmentId) &&
          isValidAssessmentEntry(incoming(), crewId, assessmentId) &&
          incoming().createdAt == request.time &&
          (isMedicalChief() || isCrewOwner(crewId));
        allow update, delete: if false;
      }
    }

    // 5. Centralized Alerts (Astronaut reads/lists ONLY own crewId; CRITICAL ack/resolve protected to Medical Chief)
    match /alerts/{alertId} {
      allow get: if isValidId(alertId) && (
        isMedicalChief() ||
        (isActiveAstronaut() && existing().crewId == userDoc().crewId)
      );
      allow list: if isMedicalChief() ||
        (isActiveAstronaut() && resource.data.crewId == userDoc().crewId);
      allow create: if isValidId(alertId) &&
        isValidAlert(incoming(), alertId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time &&
        incoming().acknowledgementStatus == 'UNACKNOWLEDGED' &&
        incoming().resolutionStatus == 'OPEN' &&
        (isMedicalChief() || isCrewOwner(incoming().crewId));
      allow update: if isValidId(alertId) &&
        isValidAlert(incoming(), alertId) &&
        incoming().alertId == existing().alertId &&
        incoming().crewId == existing().crewId &&
        incoming().severity == existing().severity &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          (
            isMedicalChief() &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'acknowledgementStatus', 'acknowledgedBy', 'acknowledgedByUid', 'acknowledgedAt',
              'resolutionStatus', 'resolvedBy', 'resolvedAt', 'updatedAt'
            ]) &&
            (existing().resolutionStatus != 'RESOLVED' || incoming().resolutionStatus == 'RESOLVED')
          ) ||
          (
            isCrewOwner(existing().crewId) &&
            existing().severity == 'CAUTION' &&
            existing().acknowledgementStatus == 'UNACKNOWLEDGED' &&
            incoming().acknowledgementStatus == 'ACKNOWLEDGED' &&
            incoming().resolutionStatus == existing().resolutionStatus &&
            incoming().acknowledgedByUid == request.auth.uid &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'acknowledgementStatus', 'acknowledgedBy', 'acknowledgedByUid', 'acknowledgedAt', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    // 6. Countermeasure records (Isolated per crewId)
    match /countermeasureRecords/{recordId} {
      allow get: if isValidId(recordId) && (
        isMedicalChief() ||
        (isActiveAstronaut() && existing().crewId == userDoc().crewId)
      );
      allow list: if isMedicalChief() ||
        (isActiveAstronaut() && resource.data.crewId == userDoc().crewId);
      allow create: if isValidId(recordId) &&
        isValidCountermeasureRecord(incoming(), recordId) &&
        incoming().updatedAt == request.time &&
        (isMedicalChief() || isCrewOwner(incoming().crewId));
      allow update: if isValidId(recordId) &&
        isValidCountermeasureRecord(incoming(), recordId) &&
        incoming().recordId == existing().recordId &&
        incoming().crewId == existing().crewId &&
        incoming().updatedAt == request.time &&
        (
          isMedicalChief() ||
          (
            isCrewOwner(existing().crewId) &&
            incoming().diff(existing()).affectedKeys().hasOnly([
              'completionStatus', 'progress', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    // 7. Flight Surgeon clinical notes (STRICTLY Medical Chief only)
    match /surgeonNotes/{noteId} {
      allow get: if isValidId(noteId) && isMedicalChief();
      allow list: if isMedicalChief();
      allow create: if isValidId(noteId) &&
        isMedicalChief() &&
        isValidSurgeonNote(incoming(), noteId) &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    // 8. Centralized demonstration evaluation thresholds (Active users read; ONLY Medical Chief writes)
    match /evaluationConfig/{configId} {
      allow get: if isValidId(configId) && isActiveUser();
      allow list: if false;
      allow create, update: if isValidId(configId) &&
        isMedicalChief() &&
        isValidEvaluationConfig(incoming(), configId) &&
        incoming().updatedAt == request.time;
      allow delete: if false;
    }

    // 9. Immutable security & clinical audit logs (Append-only; Medical Chief reads only)
    match /auditLogs/{logId} {
      allow get: if isValidId(logId) && isMedicalChief();
      allow list: if isMedicalChief();
      allow create: if isValidId(logId) &&
        isVerifiedUser() &&
        isValidAuditLog(incoming(), logId) &&
        incoming().createdAt == request.time;
      allow update, delete: if false;
    }
  }
}

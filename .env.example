FIREBASE_SERVICE_ACCOUNT=
# Required for first Chief provisioning and Firebase Admin authorization.
MEDICAL_CHIEF_EMAIL=
MEDICAL_CHIEF_PASSWORD_HASH=
SESSION_HMAC_SECRET=
# Optional: local revoked-session store path for single-instance deployments.
# Keep it outside public/ and dist/; the default is server-data/.
SESSION_REVOCATION_STORE=
# Defaults to 127.0.0.1. Set only when external access is explicitly required.
HOST=
# Optional comma-separated exact origins allowed to POST/PUT/PATCH/DELETE.
# Example: https://astroguard.example.org
TRUSTED_ORIGINS=
# Optional: set only when Express is behind a known trusted proxy.
# Accepts a hop count (for example 1) or comma-separated trusted IP/CIDR values.
TRUST_PROXY=
# Optional: Python interpreter used by the Express -> bridge integration.
PYTHON_EXECUTABLE=python